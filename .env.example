# AI credentials stay on the server. Never expose them in public/app.js.
# Provider: deepseek, newapi, or custom.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_THINKING=disabled
AI_MAX_TOKENS=64000
AI_TIMEOUT_MS=240000

# New API example:
# AI_PROVIDER=newapi
# AI_BASE_URL=https://your-newapi-domain/v1
# AI_API_KEY=your-platform-token
# AI_MODEL=your-model-id

# Local flow verification only. Do not enable for real conversions.
AI_MOCK=0
