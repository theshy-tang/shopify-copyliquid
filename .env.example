# DeepSeek API Key stays on the server. Never expose it in public/app.js.
DEEPSEEK_API_KEY=

# Current models: deepseek-v4-flash or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=64000
DEEPSEEK_TIMEOUT_MS=240000
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local flow verification only. Do not enable for real conversions.
DEEPSEEK_MOCK=0
